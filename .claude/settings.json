{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Agent(claude-code-guide)",
      "Agent(statusline-setup)",
      "Agent(model:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "session-start"],
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "pre-shell"],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "pre-agent"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "after-edit"],
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "after-shell"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "stop"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
